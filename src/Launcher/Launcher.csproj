    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PayloadZip Condition="'$(PayloadZip)' == ''">$(RPA_PAYLOAD_ZIP)</PayloadZip>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.IO.Compression" />
    <Compile Include="BundleLauncher.cs" />
    <Compile Include="..\Shared\AssemblyInfo.cs"><Link>Properties\AssemblyInfo.cs</Link></Compile>
    <EmbeddedResource Include="$(PayloadZip)"><LogicalName>runtime.zip</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Target Name="CheckPayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(PayloadZip)')" Text="Set PayloadZip or RPA_PAYLOAD_ZIP to runtime.zip generated by Build.ps1." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
